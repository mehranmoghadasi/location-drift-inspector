{
  "manifest_version": 3,
  "name": "Location Drift Inspector",
  "version": "1.1.0",
  "description": "Compare your Google Business Profile spreadsheet with each location page's JSON-LD and visible hours, date by date.",
  "action": {
    "default_title": "Check this location page",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
