{
  "name": "location-drift-inspector",
  "version": "1.1.0",
  "description": "Chrome MV3 extension + CLI that compares a Google Business Profile spreadsheet (including Google's pending updates) with each location page's JSON-LD and visible hours, date by date, and writes non-destructive fixes.",
  "type": "module",
  "license": "MIT",
  "author": "Mehran Moghadasi",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehranmoghadasi/location-drift-inspector"
  },
  "engines": {
    "node": ">=18.18"
  },
  "bin": {
    "drift-inspector": "bin/drift-inspector.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "demo": "node examples/demo.mjs",
    "preview": "node scripts/serve.mjs",
    "inspect": "node bin/drift-inspector.mjs",
    "package": "node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0"
  }
}
